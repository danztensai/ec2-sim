#!/bin/sh
# Entrypoint for systemd-mode AMIs: prepare per-instance state, then hand PID 1 to systemd.
# (cloud-init's job on real EC2: authorized_keys, host keys, user data.)
set -u
U="${EC2SIM_DEFAULT_USER:-ubuntu}"
mkdir -p /run/ec2sim /var/lib/ec2sim
: > /run/ec2sim/env
for v in EC2SIM_INSTANCE_ID EC2SIM_REGION EC2SIM_INSTANCE_TYPE EC2SIM_USER_DATA EC2SIM_DEFAULT_USER; do
  eval "val=\${$v:-}"
  printf '%s="%s"\n' "$v" "$val" >> /run/ec2sim/env
done
if [ -n "${EC2SIM_SSH_PUBKEY:-}" ] && H=$(getent passwd "$U" | cut -d: -f6); then
  mkdir -p "$H/.ssh"
  grep -qxF "$EC2SIM_SSH_PUBKEY" "$H/.ssh/authorized_keys" 2>/dev/null \
    || echo "$EC2SIM_SSH_PUBKEY" >> "$H/.ssh/authorized_keys"
  chown -R "$U:$U" "$H/.ssh"; chmod 700 "$H/.ssh"; chmod 600 "$H/.ssh/authorized_keys"
fi
ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1 || ssh-keygen -A >/dev/null 2>&1
exec /sbin/init
