#!/bin/sh
# ec2-sim instance "boot" script: the container entrypoint for ec2-sim base AMIs.
# Mimics what cloud-init does on a real EC2 instance's first boot.
set -u
U="${EC2SIM_DEFAULT_USER:-ec2-user}"
STATE=/var/lib/ec2sim
mkdir -p "$STATE"

# 1. Install the launch key pair's public key for the default user.
if [ -n "${EC2SIM_SSH_PUBKEY:-}" ]; then
  H=$(getent passwd "$U" | cut -d: -f6)
  mkdir -p "$H/.ssh"
  grep -qxF "$EC2SIM_SSH_PUBKEY" "$H/.ssh/authorized_keys" 2>/dev/null \
    || echo "$EC2SIM_SSH_PUBKEY" >> "$H/.ssh/authorized_keys"
  chown -R "$U:$U" "$H/.ssh"; chmod 700 "$H/.ssh"; chmod 600 "$H/.ssh/authorized_keys"
fi

# 2. Host keys (regenerated per instance, like cloud-init does).
ssh-keygen -A >/dev/null 2>&1

# 3. User data: run once per instance (marker is per instance ID, so AMIs
#    committed from this instance still run user data on their own instances).
MARK="$STATE/user-data.done.${EC2SIM_INSTANCE_ID:-unknown}"
if [ -n "${EC2SIM_USER_DATA:-}" ] && [ ! -f "$MARK" ]; then
  echo "$EC2SIM_USER_DATA" | base64 -d > "$STATE/user-data" 2>/dev/null \
    || echo "$EC2SIM_USER_DATA" > "$STATE/user-data"
  touch "$MARK"
  if head -c 2 "$STATE/user-data" | grep -q '#!'; then
    chmod +x "$STATE/user-data"
    ( "$STATE/user-data" >> /var/log/cloud-init-output.log 2>&1 ; echo "user-data exit=$?" >> /var/log/cloud-init-output.log ) &
  fi
fi

mkdir -p /run/sshd
exec /usr/sbin/sshd -D -e
